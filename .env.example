# OpenAI API Key (Required for GPT-4 symptom analysis)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use (Default: gpt-4o-mini or gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom OpenAI-compatible base URL (e.g., Groq, OpenRouter, LocalAI)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Flask Application Secret Key
FLASK_SECRET_KEY=medical_symptom_assistant_secret_2026

# Server Port (Default: 5000)
PORT=5000
